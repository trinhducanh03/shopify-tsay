<div class="faqs">
    {% if product %}
        <h2>{{ product.metafields.custom.faq_title.value }}</h2>

        <p>{{ product.metafields.custom.faq_description.value }}</p>

        {{ product.metafields.custom.faq_list.value | json }}

        {% comment %} {% for block in section.blocks %}
            <div class="faq-item">
                <h3>{{ block.settings.question }}</h3>
                <p>{{ block.settings.answer }}</p>
            </div>
        {% endfor %}      {% endcomment %}
    {% else %}
        <h2>{{ section.settings.heading }}</h2>

        <p>{{ section.settings.description }}</p>

        {% for block in section.blocks %}
            <div class="faq-item">
                <h3>{{ block.settings.question }}</h3>
                <p>{{ block.settings.answer }}</p>
            </div>
        {% endfor %}
    {% endif %}
</div>


{% schema %} 
{
    "name": "Faqs Forix",
    "tag": "section",
    "class": "faqs-section",

    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
        }
    ],
    "blocks": [
        {
            "type": "faq",
            "name": "FAQ Item",
            "settings": [
                {
                    "type": "text",
                    "id": "question",
                    "label": "Question",
                },
                {
                    "type": "textarea",
                    "id": "answer",
                    "label": "Answer",
                }
            ]
        },
        
    ],
    "presets": [
        {
            "name": "FAQs"
        }
    ]
}
{% endschema %}