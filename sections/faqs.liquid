{% assign infor_faqs = product.metafields.custom.info_faqs.value %}
<pre>{{ product.metafields.custom.info_faqs | json }}</pre>

{% if infor_faqs and infor_faqs.size > 0 %}
  <section>
    <div class="container">
      <h2>Custom Faqs Products</h2>
      {% for faq in infor_faqs %}
        <details>
          <summary>{{ faq.question }}</summary>
          <div>{{ faq.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Section Faqs",
  "class": "section-faqs",
  "presets": [{ "name": "Custom FAQs", "category": "Text" }],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
