<section class="section-faqs">
  <div class="container">
    <div class="header-faqs">
      {% if section.settings['title-faqs'] != blank %}
        <h2>{{ section.settings['title-faqs'] }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>
    <div class="body-faqs">
      {% for block in section.blocks %}
        {% if block.type.faqs %}
          <details class="faq-basic__item">
            <summary class="faqs-q">
              {{ block.settings.text }}
            </summary>
            <div class="faqs-a">
              {{ block.settings.answer }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Section Faqs",
  "class": "section-faqs",
  "settings": [
    { "type": "text", "id": "title-faqs", "label": "Title Faqs" },
    { "type": "richtext", "id": "description", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "faqs",
      "name": "Faqs item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "FAQs", "category": "Text" }],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
