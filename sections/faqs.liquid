{% assign faq_entries = product.metafields.custom.inofr_faqs.value %}

{% if faq_entries and faq_entries.size > 0 %}
  <section class="section-faqs">
    <div class="container">
      <h2 class="faqs-title">FAQs</h2>

      {% for entry in faq_entries %}
        <details
          class="faq-item"
          {% if forloop.first %}
            open
          {% endif %}
        >
          <summary class="faq-question">{{ entry.question | escape }}</summary>
          <div class="faq-answer rte">{{ entry.answer | metafield_tag }}</div>
        </details>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% comment %}
  {% schema %}
  {
    "name": "Section Faqs",
    "class": "section-faqs",
    "settings": [
      { "type": "text", "id": "title-faqs", "label": "Title Faqs" },
      { "type": "richtext", "id": "description", "label": "Description" }
    ],
    "blocks": [
      {
        "type": "faqs",
        "name": "Faqs item",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question"
          },
          {
            "type": "richtext",
            "id": "answer",
            "label": "Answer"
          }
        ]
      }
    ],
    "max_blocks": 50,
    "presets": [{ "name": "FAQs", "category": "Text" }],
    "enabled_on": { "templates": ["*"] }
  }
  {% endschema %}
{% endcomment %}
