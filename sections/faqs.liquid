<div class="faqs">
    {% if product %}
      <h2>{{ product.metafields.custom.faq_title.value }}</h2>
  
      <p>{{ product.metafields.custom.faq_description.value }}</p>
  
      {% for faq in product.metafields.custom.faq_list.value %}
        <details class="faq-item">
          <summary class="faq-question">
            {{ faq.question.value }}
          </summary>
  
          <div class="faq-answer">
            {{ faq.answer.value }}
          </div>
        </details>
      {% endfor %}
    {% else %}
      <h2>{{ section.settings.heading }}</h2>
  
      <p>{{ section.settings.description }}</p>
  
      {% for block in section.blocks %}
        <details class="faq-item">
          <summary class="faq-question">
            {{ block.settings.question }}
          </summary>
  
          <div class="faq-answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    {% endif %}
</div>
<style>
    .faq-item {
      border-bottom: 1px solid #ddd;
      padding: 16px 0;
    }
  
    .faq-question {
      cursor: pointer;
      font-weight: 600;
    }
  
    .faq-answer {
      padding-top: 12px;
    }
  </style>

{% schema %} 
{
    "name": "Faqs Forix",
    "tag": "section",
    "class": "faqs-section",

    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
        }
    ],
    "blocks": [
        {
            "type": "faq",
            "name": "FAQ Item",
            "settings": [
                {
                    "type": "text",
                    "id": "question",
                    "label": "Question",
                },
                {
                    "type": "textarea",
                    "id": "answer",
                    "label": "Answer",
                }
            ]
        },
        
    ],
    "presets": [
        {
            "name": "FAQs"
        }
    ]
}
{% endschema %}