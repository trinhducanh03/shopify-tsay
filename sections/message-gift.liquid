{% comment %}
  Section -> render random 1 block
  -> Blocks
      admin enter 10 blbock
  ajax add -> call ajax section render
{% endcomment %}

{% comment %}
  sections/random-messages.liquid
  Hiển thị ngẫu nhiên đúng 1 block trong số các block admin nhập.
{% endcomment %}

<section id="RandomMessages" class="random-messages" data-section-id="{{ section.id }}">
  {% if section.blocks.size > 0 %}
    {%- assign seed = 'now' | date: '%s' | plus: 0 -%}
    {%- assign idx = seed | modulo: section.blocks.size -%}
    {%- for block in section.blocks offset: idx limit: 1 -%}
      <div class="random-message" data-block-id="{{ block.id }}">
        {{ block.settings.text }}
      </div>
    {%- endfor -%}
  {% else %}
    <div class="random-message--empty">Chưa có message nào.</div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Random messages",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [{ "type": "text", "id": "text", "label": "Nội dung message" }]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "Random messages" }]
}
{% endschema %}
