<section class="feature-banner">
  <div class="container">
    {% if section.settings.kicker != blank %}
      <p class="kicker">{{ section.settings.kicker }}</p>
    {% endif %}
    <h2 class="title">{{ section.settings.title | escape }}</h2>
    {% if section.settings.subtitle != blank %}
      <div class="subtitle">{{ section.settings.subtitle }}</div>
    {% endif %}

    <div class="blocks">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'text' %}
            <div class="b-text" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% when 'button' %}
            <a class="b-btn" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{ block.settings.label | escape }}
            </a>
          {% when '@app' %}
            {% render block %} {# render app block #}
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  <style>
    .feature-banner {
      padding: 40px 0;
    }
    .feature-banner .kicker {
      opacity: 0.7;
    }
    .feature-banner .blocks {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    .feature-banner .b-btn {
      padding: 10px 16px;
      border: 1px solid #ddd;
      border-radius: 8px;
    }
  </style>

  {% schema %}
{
  "name": "Feature banner",
  "tag": "section",
  "class": "feature-banner",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "title", "label": "Title", "default": "Section title" },
    { "type": "richtext", "id": "subtitle", "label": "Subtitle" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text" }]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    { "type": "@app" } // cho phép App Blocks
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Feature banner",
      "blocks": [{ "type": "text" }, { "type": "button" }]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
  {% endschema %}
</section>
