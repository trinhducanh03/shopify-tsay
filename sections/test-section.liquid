<section class="feature-banner">
  <div class="container">
    {% if section.settings['text-banner'] != blank %}
      <p>{{ section.settings['text-banner'] }}</p>
    {% endif %}
    {% if section.settings['sub-text-banner'] != blank %}
      <h2>{{ section.settings['sub-text-banner'] }}</h2>
    {% endif %}
    <div class="block">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'text' %}
            <p>{{ block.settings.text }}</p>
          {% when 'button' %}
            <a href="{{ block.settings.link }}">{{ block.settings.label }}</a>
            >>>>>>> 63c4611 (update theme)
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Test banner",
  "class": "test-banner",
  "settings": [
    { "type": "text", "id": "text-banner", "label": "Label" },
    { "type": "text", "id": "sub-text-banner", "label": "Sup Label" }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    { "type": "@app" }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Test Banner",
      "blocks": [{ "type": "text" }, { "type": "button" }]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
