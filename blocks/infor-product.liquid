{%- comment -%} blocks/infor-product.liquid {%- endcomment -%}
<div class="infor-product-block" {{ block.shopify_attributes }}>
  {%- assign title_product = product.metafields.custom.title -%}
  {%- assign description_product = product.metafields.custom.description -%}

  {%- if block.settings.show_title and title_product != blank -%}
    <p class="infor-title">{{ title_product }}</p>
  {%- endif -%}

  {%- if block.settings.show_desc and description_product != blank -%}
    <p class="infor-desc">{{ description_product }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Infor Product",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show metafield title", "default": true },
    { "type": "checkbox", "id": "show_desc", "label": "Show metafield description", "default": true }
  ]
}
{% endschema %}
